{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "outDir": "../dist-electron",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "electron"]
  },
  "include": ["./**/*.ts", "./**/*.cts", "./**/*.mts"]
}
