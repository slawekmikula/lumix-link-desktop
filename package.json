{
  "name": "lumix-link-desktop",
  "version": "2.0.0",
  "description": "Electron + React + Vite control and live view for Panasonic Lumix cameras",
  "author": {
    "name": "Lumix Link Desktop Team",
    "email": "slawek.mikula+lumix-link-desktop@gmail.com"
  },
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite dev --host\" \"tsc -w -p electron/tsconfig.json\" \"wait-on http-get://localhost:5173 dist-electron/main.js && cross-env ELECTRON_DISABLE_SANDBOX=true electron dist-electron/main.js\"",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "start": "electron dist-electron/main.js",
    "dist": "npm run build && electron-builder --linux --win"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.4.0",
    "electron-builder": "^24.13.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.lumix.link.desktop",
    "productName": "Lumix Link Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
